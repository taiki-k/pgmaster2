#}{% extends "base.html.jinja2" %}
{% block title %}{{ project }} - Search{% endblock %}
{% block toolbar_title %} search commits {% endblock %}
{% block message %}Select a branch to search.{% endblock %}
{% block selections %}
      <form action="/p/{{ project }}/search" method="POST">
      <v-row>
        <v-col cols="6">
          <v-card elevation="2">
            <div id="branchlist">
              <v-container fluid>
                <v-radio-group v-model="search.branchname" name="branchname">
{% for branch in branches %}
                <v-radio label="{{ branch.name }}" value="{{ branch.name }}"></v-radio>
{% endfor %}
                </v-radio-group>
              </v-container>
            </div>
          </v-card>
        </v-col>
        <v-col cols="6">

        <div id="searchdata">
          <v-text-field name="searchdata1" v-model="search.word" label="search word" placeholder="enter search word"></v-text-field>
          <v-btn type="submit">Search</v-btn>
        </div>
        <v-col>
          <p style="color: red;">{{ message }}</p>
        </v-col>
        </v-col>
      </v-row>
      </form>
{% endblock %}

{% block navi_items %}
          {
            title: "{{ project }}",
            disabled: false,
            href: "{{ url_for('project', project = project) }}"
          },
          {
            title: "Search",
            disabled: true,
            href: "#"
          },
{% endblock %}

{% block extra_data %}
        search: {
          branchname: '{{ firstbranch }}',
          word: '',
        }
{% endblock %}
